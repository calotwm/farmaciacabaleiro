{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm build"
  },
  "deploy": {
    "startCommand": "sh -c 'pnpm db:migrate && pnpm db:seed && pnpm start'",
    "healthcheckPath": "/login",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  }
}
