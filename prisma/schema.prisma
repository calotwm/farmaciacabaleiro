// Farmacia Cabaleiro data model.
// Conventions: snake_case tables/columns, UUID ids generated by Postgres,
// instants as timestamptz(3), calendar dates (expiry, event dates) as DATE.
// Extra constraints Prisma cannot express (CHECKs, append-only trigger) live in
// the `stock_movement_append_only` migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("product_status")
}

enum LotStatus {
  AVAILABLE
  QUARANTINE
  BLOCKED
  EXPIRED
  DEPLETED

  @@map("lot_status")
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN
  WRITE_OFF
  // Legacy, direction-less value: never written. Counts use the _IN/_OUT pair.
  COUNT_CORRECTION
  COUNT_CORRECTION_IN
  COUNT_CORRECTION_OUT
  BLOCK
  UNBLOCK

  @@map("stock_movement_type")
}

enum AdjustmentReasonKind {
  ADJUSTMENT
  WRITE_OFF
  RETURN

  @@map("adjustment_reason_kind")
}

enum StockCountStatus {
  OPEN
  CLOSED

  @@map("stock_count_status")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE

  @@map("supplier_status")
}

enum DeliveryType {
  DELIVERY
  SALES_VISIT
  ORDER_TAKING
  OTHER

  @@map("delivery_type")
}

enum DeliveryStatus {
  SCHEDULED
  CONFIRMED
  RECEIVED
  RESCHEDULED
  CANCELLED
  // Outcome of a non-delivery visit (sales visit, order taking, other): it happened, nothing was received.
  COMPLETED

  @@map("delivery_status")
}

enum ReceiptStatus {
  DRAFT
  CONFIRMED

  @@map("receipt_status")
}

enum ReceiptIssueType {
  SHORTAGE
  EXCESS
  DAMAGED
  WRONG_PRODUCT
  OTHER

  @@map("receipt_issue_type")
}

enum AlertRule {
  LOT_EXPIRY_THRESHOLD
  LOT_EXPIRED_WITH_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  DELIVERY_UPCOMING
  DELIVERY_LATE
  RECEIPT_ISSUE

  @@map("alert_rule")
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("notification_priority")
}

enum DeliveryChannel {
  PUSH
  EMAIL

  @@map("delivery_channel")
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED

  @@map("outbox_status")
}

// ---------------------------------------------------------------------------
// Access
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  username     String?   @unique
  passwordHash String    @map("password_hash")
  name         String
  active       Boolean   @default(true)
  roleId       String    @map("role_id") @db.Uuid
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  role                 Role                      @relation(fields: [roleId], references: [id])
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]
  stockMovements       StockMovement[]
  stockCounts          StockCount[]
  scheduledDeliveries  ScheduledDelivery[]
  confirmedReceipts    Receipt[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  notificationSettings UserNotificationSettings?
  pushSubscriptions    PushSubscription[]
  updatedSettings      Setting[]

  @@index([roleId])
  @@map("users")
}

model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("categories")
}

model Unit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("units")
}

model Product {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String        @unique
  commercialName      String        @map("commercial_name")
  activeIngredient    String?       @map("active_ingredient")
  brand               String?
  laboratory          String?
  barcode             String?       @unique
  sku                 String?       @unique
  categoryId          String        @map("category_id") @db.Uuid
  presentation        String?
  concentration       String?
  pharmaceuticalForm  String?       @map("pharmaceutical_form")
  contentPerPackage   String?       @map("content_per_package")
  unitId              String        @map("unit_id") @db.Uuid
  minStock            Int           @default(0) @map("min_stock")
  maxStock            Int?          @map("max_stock")
  costPrice           Decimal       @default(0) @map("cost_price") @db.Decimal(12, 2)
  salePrice           Decimal?      @map("sale_price") @db.Decimal(12, 2)
  usualSupplierId     String?       @map("usual_supplier_id") @db.Uuid
  location            String?
  status              ProductStatus @default(ACTIVE)
  notes               String?
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category              Category               @relation(fields: [categoryId], references: [id])
  unit                  Unit                   @relation(fields: [unitId], references: [id])
  usualSupplier         Supplier?              @relation("ProductUsualSupplier", fields: [usualSupplierId], references: [id], onDelete: SetNull)
  lots                  Lot[]
  stockMovements        StockMovement[]
  stockCountLines       StockCountLine[]
  supplierProducts      SupplierProduct[]
  deliveryExpectedItems DeliveryExpectedItem[]
  receiptLines          ReceiptLine[]
  receiptIssues         ReceiptIssue[]

  @@index([categoryId])
  @@index([unitId])
  @@index([usualSupplierId])
  @@index([status])
  @@index([commercialName])
  @@index([activeIngredient])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Lot {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  lotNumber        String    @map("lot_number")
  expiryDate       DateTime  @map("expiry_date") @db.Date
  initialQuantity  Int       @map("initial_quantity")
  currentQuantity  Int       @map("current_quantity")
  blockedQuantity  Int       @default(0) @map("blocked_quantity")
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  supplierId       String?   @map("supplier_id") @db.Uuid
  invoiceNumber    String?   @map("invoice_number")
  unitCost         Decimal?  @map("unit_cost") @db.Decimal(12, 2)
  location         String?
  status           LotStatus @default(AVAILABLE)
  notes            String?
  receiptLineId    String?   @map("receipt_line_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product         Product          @relation(fields: [productId], references: [id])
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  receiptLine     ReceiptLine?     @relation(fields: [receiptLineId], references: [id], onDelete: SetNull)
  movements       StockMovement[]
  stockCountLines StockCountLine[]

  @@unique([productId, lotNumber, expiryDate])
  @@index([expiryDate])
  @@index([productId, status])
  @@index([supplierId])
  @@index([receiptLineId])
  @@index([status, expiryDate])
  @@map("lots")
}

model AdjustmentReason {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  kind      AdjustmentReasonKind
  active    Boolean              @default(true)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  movements StockMovement[]

  @@unique([kind, name])
  @@map("adjustment_reasons")
}

// Append-only: UPDATE/DELETE are rejected by a trigger (see migration).
model StockMovement {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          StockMovementType
  lotId         String            @map("lot_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  quantity      Int
  balanceAfter  Int               @map("balance_after")
  reasonId      String?           @map("reason_id") @db.Uuid
  reasonText    String?           @map("reason_text")
  userId        String            @map("user_id") @db.Uuid
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  occurredAt    DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  lot     Lot               @relation(fields: [lotId], references: [id])
  product Product           @relation(fields: [productId], references: [id])
  reason  AdjustmentReason? @relation(fields: [reasonId], references: [id])
  user    User              @relation(fields: [userId], references: [id])

  @@index([productId, occurredAt])
  @@index([lotId, occurredAt])
  @@index([reasonId])
  @@index([userId])
  @@index([referenceType, referenceId])
  @@index([type, occurredAt])
  @@map("stock_movements")
}

model StockCount {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status      StockCountStatus @default(OPEN)
  createdById String           @map("created_by_id") @db.Uuid
  notes       String?
  closedAt    DateTime?        @map("closed_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User             @relation(fields: [createdById], references: [id])
  lines     StockCountLine[]

  @@index([createdById])
  @@index([status])
  @@map("stock_counts")
}

model StockCountLine {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockCountId     String   @map("stock_count_id") @db.Uuid
  lotId            String   @map("lot_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  expectedQuantity Int      @map("expected_quantity")
  countedQuantity  Int?     @map("counted_quantity")
  difference       Int?
  reconciled       Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  lot        Lot        @relation(fields: [lotId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([stockCountId, lotId])
  @@index([lotId])
  @@index([productId])
  @@map("stock_count_lines")
}

// ---------------------------------------------------------------------------
// Suppliers and deliveries
// ---------------------------------------------------------------------------

model Supplier {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  cuit          String?        @unique
  contactName   String?        @map("contact_name")
  phone         String?
  email         String?
  address       String?
  visitDays     Int[]          @default([]) @map("visit_days")
  deliveryHours String?        @map("delivery_hours")
  leadTimeDays  Int?           @map("lead_time_days")
  status        SupplierStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  usualProducts       Product[]           @relation("ProductUsualSupplier")
  supplierProducts    SupplierProduct[]
  lots                Lot[]
  scheduledDeliveries ScheduledDelivery[]
  receipts            Receipt[]

  @@index([name])
  @@index([status])
  @@map("suppliers")
}

model SupplierProduct {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId])
  @@map("supplier_products")
}

model ScheduledDelivery {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId        String         @map("supplier_id") @db.Uuid
  scheduledAt       DateTime       @map("scheduled_at") @db.Timestamptz(3)
  type              DeliveryType   @default(DELIVERY)
  status            DeliveryStatus @default(SCHEDULED)
  orderNumber       String?        @map("order_number")
  responsibleUserId String?        @map("responsible_user_id") @db.Uuid
  notes             String?
  rescheduledFromId String?        @map("rescheduled_from_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier        Supplier               @relation(fields: [supplierId], references: [id])
  responsibleUser User?                  @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)
  rescheduledFrom ScheduledDelivery?     @relation("DeliveryReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   ScheduledDelivery[]    @relation("DeliveryReschedule")
  expectedItems   DeliveryExpectedItem[]
  receipts        Receipt[]

  @@index([scheduledAt, status])
  @@index([supplierId])
  @@index([responsibleUserId])
  @@index([rescheduledFromId])
  @@map("scheduled_deliveries")
}

model DeliveryExpectedItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId       String   @map("delivery_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  expectedQuantity Int      @map("expected_quantity")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  delivery ScheduledDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])

  @@unique([deliveryId, productId])
  @@index([productId])
  @@map("delivery_expected_items")
}

// ---------------------------------------------------------------------------
// Receiving
// ---------------------------------------------------------------------------

model Receipt {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId     String?       @map("delivery_id") @db.Uuid
  supplierId     String        @map("supplier_id") @db.Uuid
  invoiceNumber  String?       @map("invoice_number")
  status         ReceiptStatus @default(DRAFT)
  isPartial      Boolean       @default(false) @map("is_partial")
  idempotencyKey String        @unique @map("idempotency_key")
  confirmedById  String?       @map("confirmed_by_id") @db.Uuid
  confirmedAt    DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  delivery    ScheduledDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  supplier    Supplier           @relation(fields: [supplierId], references: [id])
  confirmedBy User?              @relation(fields: [confirmedById], references: [id], onDelete: SetNull)
  lines       ReceiptLine[]
  issues      ReceiptIssue[]

  @@index([deliveryId])
  @@index([supplierId])
  @@index([confirmedById])
  @@index([status])
  @@map("receipts")
}

model ReceiptLine {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId       String   @map("receipt_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  lotNumber       String   @map("lot_number")
  expiryDate      DateTime @map("expiry_date") @db.Date
  quantity        Int
  unitCost        Decimal  @map("unit_cost") @db.Decimal(12, 2)
  damagedQuantity Int      @default(0) @map("damaged_quantity")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  lots    Lot[]

  @@index([receiptId])
  @@index([productId])
  @@map("receipt_lines")
}

model ReceiptIssue {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId   String           @map("receipt_id") @db.Uuid
  productId   String?          @map("product_id") @db.Uuid
  type        ReceiptIssueType
  quantity    Int?
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  receipt Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([productId])
  @@map("receipt_issues")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

// Idempotency: one event per (rule, entity, threshold, day).
model AlertEvent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule         AlertRule
  entityType   String    @map("entity_type")
  entityId     String    @map("entity_id")
  thresholdKey String    @default("") @map("threshold_key")
  eventDate    DateTime  @map("event_date") @db.Date
  payload      Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  notifications Notification[]

  @@unique([rule, entityType, entityId, thresholdKey, eventDate])
  @@index([eventDate])
  @@map("alert_events")
}

model Notification {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  alertEventId String?              @map("alert_event_id") @db.Uuid
  title        String
  body         String
  priority     NotificationPriority @default(MEDIUM)
  link         String?
  readAt       DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertEvent AlertEvent?             @relation(fields: [alertEventId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@unique([userId, alertEventId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([alertEventId])
  @@map("notifications")
}

model NotificationPreference {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  rule      AlertRule
  inApp     Boolean   @default(true) @map("in_app")
  push      Boolean   @default(true)
  email     Boolean   @default(false)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rule])
  @@map("notification_preferences")
}

// Quiet hours are local wall-clock minutes since midnight in the pharmacy timezone.
model UserNotificationSettings {
  userId            String   @id @map("user_id") @db.Uuid
  quietHoursEnabled Boolean  @default(false) @map("quiet_hours_enabled")
  quietHoursStart   Int?     @map("quiet_hours_start")
  quietHoursEnd     Int?     @map("quiet_hours_end")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

model PushSubscription {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  failureCount  Int       @default(0) @map("failure_count")
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  disabledAt    DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Outbox so external channel failures never touch business transactions.
model NotificationDelivery {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String          @map("notification_id") @db.Uuid
  channel        DeliveryChannel
  status         OutboxStatus    @default(PENDING)
  attempts       Int             @default(0)
  lastError      String?         @map("last_error")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status, channel])
  @@map("notification_deliveries")
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

model Setting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("settings")
}
